# Facultatif — copiez en « .env » pour personnaliser.

# Adresse de l'API utilisée par le proxy de développement Vite
VITE_API_URL=http://localhost:4000

# Port du serveur de développement
VITE_PORT=5173

# Masquer le choix des profils sur la page de connexion (false = masqué)
VITE_LOGIN_PROFILES=true
