# Copiez ce fichier en « .env » ou lancez « npm run setup » à la racine (recommandé).

# Connexion PostgreSQL : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?schema=public
# (encodez les caractères spéciaux du mot de passe : @ → %40, # → %23, etc.)
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/projet_bd?schema=public"

# Secret de signature des jetons de session — chaîne longue et aléatoire
JWT_SECRET="remplacez-moi-par-une-longue-chaine-aleatoire"
JWT_EXPIRES_IN="8h"

# Port de l'API
PORT=4000

# Origine autorisée pour le frontend en développement
CORS_ORIGIN="http://localhost:5173"

# Stockage des documents déposés
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=25
